---
const currentPath = Astro.url.pathname;

const linkClass = (path: string) =>
  currentPath === path
    ? "rounded-full bg-slate-900 px-4 py-2 text-white"
    : "rounded-full px-4 py-2 text-slate-700 transition hover:bg-slate-100 hover:text-slate-950";
---

<header class="border-b border-slate-200 bg-white">
  <div
    class="mx-auto flex max-w-7xl items-center justify-between gap-4 px-4 py-4 sm:px-6 lg:px-8"
  >
    <a
      href="/"
      class="text-lg font-bold tracking-[0.2em] text-slate-950 uppercase"
      >PokeAtlas Iván Huesca</a
    >
    <nav
      class="flex flex-wrap items-center justify-end gap-2 text-sm font-medium sm:gap-4"
    >
      <a class={linkClass("/")} href="/">Inicio</a>
      <a class={linkClass("/habitats")} href="/habitats">Habitats</a>
      <a class={linkClass("/objetos")} href="/objetos">Objetos</a>
    </nav>
  </div>
</header>
