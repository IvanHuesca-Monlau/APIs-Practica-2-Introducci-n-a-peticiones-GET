<main class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
  <section class="space-y-6">
    <div class="rounded-xl border border-slate-200 bg-white p-6">
      <h1 class="text-3xl font-bold text-slate-950">Habitats de los Pokemon</h1>
      <p class="mt-3 text-slate-700">
        Observa los diferentes habitats donde viven los Pokemon y haz clic en
        cada uno para mostrar los que se encuentran en él.
      </p>
    </div>

    <div class="rounded-xl border border-slate-200 bg-white p-6">
      <div
        class="flex flex-col gap-2 md:flex-row md:items-end md:justify-between"
      >
        <div>
          <h2 id="habitat-title" class="text-2xl font-bold text-slate-950">
            No has seleccionado ningún habitat
          </h2>
          <p id="habitat-count" class="text-sm text-slate-600 mt-1">
            Selecciona un habitat para cargar los Pokemon que se encuentran en
            él.
          </p>
        </div>
      </div>
      <div id="habitat-list" class="my-4 flex flex-wrap gap-2"></div>
      <div
        id="habitat-grid"
        class="mt-6 grid gap-4 sm:grid-cols-2 xl:grid-cols-3"
      >
      </div>
    </div>
  </section>
</main>