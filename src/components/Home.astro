<main class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
  <section class="mb-8 rounded-xl border border-slate-200 bg-white p-6">
    <h1 class="text-3xl font-bold text-slate-950 sm:text-4xl">
      Una Pokedex para consultar Pokemon, habitats y objetos.
    </h1>
    <p class="mt-3 text-slate-700">
      Busca por nombre o ID y revisa el resultado con nombre, tipos, imagen,
      sonido y juegos.
    </p>
  </section>

  <section class="rounded-xl border border-slate-200 bg-white p-6">
    <h2 class="text-2xl font-bold text-slate-950 mb-3">Busca tu Pokemon favorito</h2>
    <div class="grid gap-4 md:grid-cols-[1fr_auto]">
      <input
        id="pokemon-search-input"
        class="w-full rounded-lg border border-slate-300 px-4 py-3 outline-none focus:border-orange-500"
        type="search"
        placeholder="Introduce el nombre o ID de un Pokemon..."
      />
      <button
        id="pokemon-search-form"
        type="button"
        class="rounded-lg bg-slate-900 px-5 py-3 font-semibold text-white"
        >Buscar</button
      >
    </div>
    <div id="search-status" class="mt-4 text-sm text-slate-600">
      Introduce el nombre de un Pokemon o su ID para cargar su ficha
    </div>
    <article
      id="search-result"
      class="mt-4 hidden rounded-lg border border-slate-200 bg-slate-50 p-4"
    >
    </article>
  </section>

  <section id="pokemon-browser" class="mt-8">
    <div
      class="flex flex-col gap-3 md:flex-row md:items-end md:justify-between"
    >
      <div>
        <h2 class="text-2xl font-bold text-slate-950">Lista de Pokemon</h2>
      </div>
    </div>
    <div
      id="home-status"
      class="mt-4 rounded-lg border border-dashed border-slate-300 bg-white p-4 text-sm text-slate-600"
    >
      Cargando Pokemon iniciales...
    </div>
    <div id="home-grid" class="mt-6 grid gap-4 sm:grid-cols-2 xl:grid-cols-3">
    </div>
    <button
      id="home-load-more"
      type="button"
      class="rounded-lg bg-orange-500 px-5 py-3 font-semibold text-white mt-4 w-full"
      >Cargar más Pokemon</button
    >
  </section>
</main>

<style>
  :global(body) {
    font-feature-settings:
      "ss01" 1,
      "cv02" 1;
  }

  main {
    font-family: var(--font-body);
  }

  :global(audio::-webkit-media-controls-panel) {
    background-color: #f8fafc;
  }

  :global(audio) {
    accent-color: #ea580c;
  }

  :global(.shadow-soft) {
    box-shadow: 0 24px 80px rgba(15, 23, 42, 0.12);
  }
</style>
